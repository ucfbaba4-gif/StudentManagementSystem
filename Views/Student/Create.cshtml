@model StudentManagement.Models.Student

<h2>Ajouter un étudiant</h2>

<form asp-action="Create" method="post">

    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
    </div>

    <br />

    <div>
        <label asp-for="Age"></label>
        <input asp-for="Age" />
    </div>

    <br />

    <button type="submit">
        Ajouter
    </button>

</form>